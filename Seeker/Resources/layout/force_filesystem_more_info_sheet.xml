<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/pseudo_window_background_color">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/filesystem_moreinfo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
			android:text="@string/ForceFilesystemPermission"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/normalTextColorNonTinted" />
    </RelativeLayout>

    <TextView
        android:id="@+id/filesystem_more_info_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
		android:text="@string/force_filesystem_subtitle"
        android:textSize="15sp"
        android:textColor="?attr/normalTextColorNonTinted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
		android:gravity="center_horizontal"
		android:orientation="vertical">

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
		android:text="@string/get_fdroid_build"
        android:id="@+id/get_izzydroid_build"
        android:textSize="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:textAllCaps="false"
        android:minHeight="22dp"
        android:foreground="@drawable/button"
        style="@style/SeekerButtonStyle"
    />
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
		android:text="@string/get_github_build"
        android:id="@+id/get_github_build"
        android:textSize="16dp"
        android:layout_marginTop="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:textAllCaps="false"
        android:minHeight="22dp"
        android:foreground="@drawable/button"
        style="@style/SeekerButtonStyle"
    />
    </LinearLayout>
</LinearLayout>
