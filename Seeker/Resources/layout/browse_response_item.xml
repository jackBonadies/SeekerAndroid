<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:minHeight="@dimen/ds_touch_target_min"
    android:id="@+id/containingViewGroup"
    android:orientation="horizontal"
    android:gravity="center_vertical"
>
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:tint="?attr/dsColorTextSecondary"
        android:id="@+id/folderIcon"
        android:layout_marginStart="4dp"
        android:layout_gravity="center_vertical"
        android:visibility="gone"
        app:srcCompat="@drawable/folder_outline"
    />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
    >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:textSize="14sp"
            android:textColor="?attr/dsColorTextPrimary"
            android:id="@+id/displayName"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="test text item"
        />
        <TextView
            android:id="@+id/fileDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/dsColorTextSecondary"
            android:ellipsize="end"
            android:paddingStart="5dp"
            android:text="15mb - 10:14 - 245kbps"
            android:singleLine="true"
        />
    </LinearLayout>
    <ImageButton
        android:id="@+id/downloadButton"
        android:layout_width="@dimen/ds_touch_target_min"
        android:layout_height="@dimen/ds_touch_target_min"
        android:layout_gravity="center_vertical"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/browse_download_action"
        android:scaleType="centerInside"
        android:src="@drawable/ic_download_white_24"
        android:tint="?attr/dsColorPrimary" />
    <FrameLayout
        android:id="@+id/actionContainer"
        android:layout_width="@dimen/ds_touch_target_min"
        android:layout_height="@dimen/ds_touch_target_min"
        android:layout_gravity="center_vertical"
        android:visibility="gone">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:id="@+id/selectionCheckbox"
            android:layout_gravity="center"
            android:visibility="invisible"
            app:srcCompat="@drawable/check_circle_outline" />
        <ImageView
            android:layout_width="@dimen/ds_touch_target_min"
            android:layout_height="@dimen/ds_touch_target_min"
            android:tint="?attr/dsColorTextSecondary"
            android:id="@+id/folderIndicator"
            android:padding="@dimen/ds_space_md"
            android:visibility="invisible"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/browse_row_actions"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_more_vert_white_vector_32dp" />
    </FrameLayout>
</LinearLayout>
