<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/searchHeaderBackground"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ds_touch_target_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_md"
        android:paddingEnd="@dimen/ds_space_sm">
        <TextView
            android:id="@+id/searchResultsHeaderText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="14sp"
            android:textColor="?attr/cellTextColorSubdued" />
        <TextView
            android:id="@+id/searchSortButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/ds_touch_target_min"
            android:minWidth="@dimen/ds_touch_target_min"
            android:paddingStart="@dimen/ds_space_sm"
            android:paddingEnd="@dimen/ds_space_sm"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/cellTextColor" />
    </LinearLayout>
    <TextView
        android:id="@+id/searchActiveFiltersText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ds_space_md"
        android:paddingEnd="@dimen/ds_space_md"
        android:paddingBottom="@dimen/ds_space_xs"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="12sp"
        android:textColor="?attr/cellTextColorSubdued"
        android:visibility="gone" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/dsColorDivider" />
</LinearLayout>
