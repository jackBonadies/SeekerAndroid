<?xml version="1.0" encoding="utf-8" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
>
    <TextView
        android:id="@+id/selectTheFollowing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Users to Add"
        android:layout_marginStart="4dp"
        android:textSize="24sp"
    />
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/selectAllCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="12dp"
        android:text="@string/SelectAll"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/normalTextColorNonTinted"
    />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
    >
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewImportList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/import_list_card_bg"
        />

        <LinearLayout
            android:id="@+id/noneFoundView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone"
        >
            <ImageView
                android:id="@+id/noneFoundIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/check_circle_96dp"
                android:tint="?attr/cellTextColorSubdued"
            />

            <TextView
                android:id="@+id/noneFound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="320dp"
                android:gravity="center"
                android:breakStrategy="balanced"
                android:text="@string/NothingToImport"
                android:textSize="18sp"
                android:textColor="?attr/cellTextColor"
                android:layout_marginTop="12dp"
            />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/alreadyPresentTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:maxLines="4"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:text="Note: The following users are already present in X - a, b, c dummy"
    />
</LinearLayout>
