<?xml version="1.0" encoding="utf-8" ?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>
    <FrameLayout
        android:id="@+id/search_tabs"
        android:layout_marginStart="0dp"
        android:paddingTop="2dp"
        android:paddingStart="0dp"
        android:layout_centerVertical="true"
        android:layout_width="@dimen/ds_touch_target_min"
        android:layout_height="@dimen/ds_touch_target_min"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/search_tabs_description"
    >
        <ImageView
            android:id="@+id/search_tabs_icon"
            app:srcCompat="@drawable/numeric_tab_outline"
            android:tint="?attr/dsColorChromeForeground"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
        />
        <TextView
            android:id="@+id/search_tabs_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="?attr/dsColorChromeForeground"
            android:textSize="15sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:gravity="center"
            android:text=""
        />
    </FrameLayout>
    <Seeker.SafeMaterialAutoCompleteTextView
        android:layout_toEndOf="@id/search_tabs"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:id="@+id/searchHere"
        android:background="@drawable/ds_search_bar_background"
        android:minHeight="@dimen/ds_touch_target_min"
        android:paddingStart="@dimen/ds_space_md"
        android:paddingEnd="@dimen/ds_space_xl"
        android:paddingTop="@dimen/ds_space_sm"
        android:paddingBottom="@dimen/ds_space_sm"
        android:layout_centerVertical="true"
        android:layout_weight="1"
        android:hint="@string/search_here"
        android:contentDescription="@string/search_field_description"
        android:completionThreshold="0"
        android:singleLine="true"
        android:focusable="true"
        android:imeOptions="actionSearch"
        android:textColorHighlight="?attr/dsColorPrimaryContainer"
        android:textColor="?attr/dsColorChromeForeground"
        android:textColorHint="?attr/dsColorChromeForeground"
        android:popupBackground="?attr/colorSurface"
    />
</RelativeLayout>
