<?xml version="1.0" encoding="utf-8" ?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
    >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ImportClientData"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="?attr/normalTextColorNonTinted"
        />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ImportWizardIntro"
            android:textSize="15sp"
            android:alpha="0.7"
            android:textColor="?attr/normalTextColor"
            android:lineSpacingExtra="3dp"
        />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/WorksWithExportsFrom"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:alpha="0.6"
            android:textColor="?attr/normalTextColor"
        />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
        >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SoulseekQT"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/normalTextColorNonTinted"
            />
            <TextView
                android:id="@+id/qtExportPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="14sp"
                android:alpha="0.75"
                android:textColor="?attr/normalTextColor"
                android:lineSpacingExtra="2dp"
            />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/expandableModernSeparatorColor"
        />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
        >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nicotine+"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/normalTextColorNonTinted"
            />
            <TextView
                android:id="@+id/nicotineExportPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="14sp"
                android:alpha="0.75"
                android:textColor="?attr/normalTextColor"
                android:lineSpacingExtra="2dp"
            />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/expandableModernSeparatorColor"
        />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
        >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seeker"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/normalTextColorNonTinted"
            />
            <TextView
                android:id="@+id/seekerExportPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="14sp"
                android:alpha="0.75"
                android:textColor="?attr/normalTextColor"
                android:lineSpacingExtra="2dp"
            />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button"
            android:id="@+id/importData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="56dp"
            android:text="@string/ChooseExportFile"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:icon="@drawable/folder_upload_outline"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
        />

        <androidx.core.widget.ContentLoadingProgressBar
            android:layout_width="match_parent"
            android:id="@+id/contentLoadingProgressBar1"
            android:layout_marginTop="20dp"
            android:layout_height="wrap_content"
            style="@android:style/Widget.DeviceDefault.ProgressBar"
            android:indeterminate="true"
        />
    </LinearLayout>
</ScrollView>
