<?xml version="1.0" encoding="utf-8" ?>
<!-- Reusable rounded input background (design system, Phase 2A).
     Replaces rounded_text_input_background_light / _dark for token themes. -->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"
>
    <solid android:color="?attr/dsColorInputBackground" />
    <stroke
        android:width="@dimen/ds_stroke_width"
        android:color="?attr/dsColorInputStroke"
    />
    <corners android:radius="@dimen/ds_corner_sm" />
</shape>
