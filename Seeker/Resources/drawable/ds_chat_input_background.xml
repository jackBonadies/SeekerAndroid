<?xml version="1.0" encoding="utf-8" ?>
<!-- Reusable pill shaped chat/message composer background (design system). -->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"
>
    <solid android:color="?attr/dsColorInputBackground" />
    <stroke
        android:width="@dimen/ds_stroke_width"
        android:color="?attr/dsColorInputStroke"
    />
    <corners android:radius="24dp" />
</shape>
