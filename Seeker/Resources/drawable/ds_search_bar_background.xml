    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/dsColorInputBackground" />
    <stroke
        android:width="@dimen/ds_stroke_width"
        android:color="?attr/dsColorInputStroke" />
    <corners android:radius="@dimen/ds_corner_lg" />
</shape>
