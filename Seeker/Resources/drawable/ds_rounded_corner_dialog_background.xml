<?xml version="1.0" encoding="utf-8" ?>
<!-- Reusable elevated dialog/sheet background (design system, Phase 2A). -->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"
>
    <solid android:color="?attr/dsColorSurfaceElevated" />
    <stroke
        android:width="@dimen/ds_stroke_width"
        android:color="?attr/dsColorOutline"
    />
    <corners android:radius="@dimen/ds_corner_lg" />
</shape>
