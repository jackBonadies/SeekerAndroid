<resources>
    <!--
        ========================================================================
        Night configuration overrides for the design system (Phase 2A).

        This file intentionally contains a SINGLE style. Before Phase 2A it
        redefined AppTheme / AppTheme.NoActionBar / SeekerBottomSheetDialog /
        checkBoxStyle / SeekerButtonStyle / navText* / AppTheme.AppBarOverlay /
        AppTheme.PopupOverlay, and the two definitions had already drifted apart
        (the night copy was missing colorSecondaryContainer, snackbarButtonStyle,
        actionModeStyle, …). Everything shared now lives once in
        values/styles.xml and is driven by the semantic tokens, so the only
        thing that still has to differ per configuration is the Material3 parent.
        ========================================================================
    -->
    <style name="Seeker.Theme.Base" parent="Theme.Material3.DayNight.NoActionBar" />
</resources>
